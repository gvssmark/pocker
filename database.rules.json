{
  "rules": {
    "rooms": {
      "$room": {
        "meta": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && auth.token.email != null && root.child('allowedEmails').child(auth.token.email.toLowerCase().replace('.',',').replace('.',',').replace('.',',').replace('.',',').replace('.',',').replace('.',',')).exists()) || (data.exists() && auth.uid === data.child('hostUid').val()))"
        },
        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val())"
          }
        },
        "hand": {
          ".read": true,
          ".write": "auth != null"
        },
        "chat": {
          ".read": true,
          ".write": "auth != null"
        },
        "breakRequests": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "private": {
      "$room": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val())"
        }
      }
    },
    "allowedEmails": {
      ".read": false,
      ".write": false
    }
  }
}
